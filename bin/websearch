#!/usr/bin/env python3
"""Query a SearXNG instance and print the raw ranked results.

Standard library only. Default instance is the container on this machine (SEARXNG_URL or
http://127.0.0.1:8888); if it is not answering, the tool starts it (waiting at most 5 seconds).
--public falls back to a public instance that allows JSON output.

    websearch server status|start|stop|update   manage the local SearXNG container
    websearch compare LIST_A LIST_B             which links two result lists share (or LIST_A --query Q)
    websearch experiment on|off|status|report   the built-in vs SearXNG experiment (see bin/websearch-hook)

    websearch scholar <query>          academic search via the Semantic Scholar API
    websearch scholar --cited-by ID    papers citing ID (DOI:..., PMID:..., ARXIV:..., or an S2 id)
    websearch scholar --references ID  papers ID cites
"""
import argparse
import fcntl
import grp
import html
import json
import os
import random
import shlex
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

T0 = time.monotonic()
REPO = Path(__file__).resolve().parent.parent
COMPOSE_FILE = REPO / "searxng" / "docker-compose.yml"
DEFAULT_URL = os.environ.get("SEARXNG_URL", "http://127.0.0.1:8888")
FALLBACK = "use the built-in web search for now"
START_WAIT = 4.5  # seconds from launch; done check 3 allows 5 in total
PUBLIC_URL = os.environ.get("SEARXNG_PUBLIC_URL", "https://searx.be")
UA = "Mozilla/5.0 (X11; Linux x86_64) research-tools/websearch"


class Unavailable(Exception):
    """SearXNG could not answer; the message is one line ending with the fallback."""


def search(base, params, timeout):
    url = base.rstrip("/") + "/search?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        body = resp.read()
    try:
        return json.loads(body), url
    except json.JSONDecodeError:
        head = body[:120].decode("utf-8", "replace").strip().replace("\n", " ")
        raise Unavailable(f"{base} did not return JSON (got: {head!r}). "
                          "Public instances usually disable the JSON API or sit behind a browser check; use the local instance.")


def failed_engines(data):
    """One line naming each engine that failed or blocked the server, with SearXNG's reason; '' when none did."""
    bad = [f"{e[0]} ({e[1]})" if len(e) > 1 and e[1] else str(e[0]) for e in data.get("unresponsive_engines") or []]
    return f"failed engines, results may be missing: {', '.join(bad)}" if bad else ""


def searx_search(base, params, timeout=30, deadline=None):
    """Search SearXNG, starting the local server first if needed. Raises Unavailable with a one-line reason."""
    if is_local(base) and not healthy(base):
        problem = ensure_server(base, T0 + START_WAIT if deadline is None else deadline)
        if problem:
            raise Unavailable(problem)
    try:
        return search(base, params, timeout)[0]
    except urllib.error.HTTPError as e:
        hint = " (json format not enabled on this instance?)" if e.code == 403 else ""
        raise Unavailable(f"HTTP {e.code} from {base}{hint}; {FALLBACK}")
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        raise Unavailable(f"cannot reach {base}: {e}; {FALLBACK}")


def state_dir():
    d = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "research-tools"
    d.mkdir(parents=True, exist_ok=True)
    return d


def is_local(base):
    return urllib.parse.urlparse(base).hostname in ("127.0.0.1", "localhost", "::1")


def healthy(base, timeout=1.0):
    try:
        with urllib.request.urlopen(base.rstrip("/") + "/healthz", timeout=timeout) as resp:
            return resp.status == 200
    except (urllib.error.URLError, TimeoutError, OSError):
        return False


def docker_cmd(args):
    """A docker command line, run through `sg docker` when this process started before the account joined the group."""
    try:
        gid = grp.getgrnam("docker").gr_gid
    except KeyError:
        return ["docker", *args]
    if os.geteuid() == 0 or gid in os.getgroups():
        return ["docker", *args]
    return ["sg", "docker", "-c", shlex.join(["docker", *args])]


def start_command():
    override = os.environ.get("WEBSEARCH_START_CMD")  # used by the tests
    return shlex.split(override) if override else docker_cmd(["compose", "-f", str(COMPOSE_FILE), "up", "-d"])


def last_line(path):
    try:
        lines = [l.strip() for l in Path(path).read_text(errors="replace").splitlines() if l.strip()]
    except OSError:
        return "no output"
    return lines[-1][:200] if lines else "no output"


def ensure_server(base, deadline):
    """Start the local server if it is not answering. Returns None once it answers, else a one-line reason.

    A lock keeps two sessions from starting it at once. The start command keeps running after this
    returns, so a server that is still starting is ready for the next search.
    """
    lock_path = state_dir() / "searxng-start.lock"
    log_path = state_dir() / "searxng-start.log"
    starting = f"SearXNG is starting, not ready yet; {FALLBACK} (if this repeats: docker logs searxng)"
    with open(lock_path, "a") as lock:
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    return starting
                time.sleep(0.1)
        if healthy(base):
            return None
        with open(log_path, "w") as log:
            try:
                proc = subprocess.Popen(start_command(), stdin=subprocess.DEVNULL, stdout=log,
                                        stderr=subprocess.STDOUT, start_new_session=True)
            except OSError as e:
                return f"SearXNG is down and could not be started ({e}); {FALLBACK}"
        while time.monotonic() < deadline:
            if healthy(base, timeout=0.5):
                return None
            rc = proc.poll()
            if rc is not None and rc != 0:
                return (f"SearXNG is down and could not be started ({last_line(log_path)}); {FALLBACK}. "
                        f"Details: {log_path} and `docker logs searxng`")
            time.sleep(0.2)
        return starting

S2_API = os.environ.get("S2_API_URL", "https://api.semanticscholar.org/graph/v1")
S2_FIELDS = "title,authors,year,publicationDate,venue,externalIds,citationCount,openAccessPdf,publicationTypes,abstract"
S2_SPACING = 1.1    # seconds between requests; the key allows 1 per second, cumulative across all endpoints
S2_DAILY_CAP = 200  # requests per UTC day, the figure promised in the key application


def config_dir():
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "research-tools"


def s2_key():
    """The key from S2_API_KEY or the private key file, trimmed; '' (after one line on stderr) when there is none."""
    key = os.environ.get("S2_API_KEY", "").strip()
    if key:
        return key
    path = config_dir() / "s2_api_key"
    try:
        key = path.read_text().strip()
        if any(c.isspace() or not c.isprintable() for c in key):
            print(f"websearch: the key in {path} holds spaces or more than one line, so it is not used; "
                  "searching without a key", file=sys.stderr)
            return ""
    except FileNotFoundError:
        print(f"websearch: no Semantic Scholar key at {path}; searching without a key (shared, often rate-limited)",
              file=sys.stderr)
        return ""
    except OSError as e:
        print(f"websearch: cannot read {path} ({e.strerror}); searching without a key", file=sys.stderr)
        return ""
    return key


def s2_slot():
    """Wait for this request's turn, across every process on this machine.

    Holds a lock on the shared state file while waiting, so requests are at least S2_SPACING apart,
    and refuses (without sending) once S2_DAILY_CAP requests have gone out today.
    """
    d = state_dir()
    path = d / "s2_requests.json"
    with open(d / "s2_requests.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            st = json.loads(path.read_text())
        except (FileNotFoundError, ValueError):
            st = {}
        today = time.strftime("%Y-%m-%d", time.gmtime())
        recent = st.get("recent") or []
        count = st.get("count", 0) if st.get("day") == today else 0
        if count >= S2_DAILY_CAP:
            sys.exit(f"websearch: Semantic Scholar daily cap reached ({S2_DAILY_CAP} requests today, UTC); "
                     f"not sent. Try again tomorrow, or {FALLBACK}")
        wait = min(recent[-1] + S2_SPACING - time.time(), S2_SPACING) if recent else 0  # a clock step cannot stall
        if wait > 0:
            time.sleep(wait)
        st = {"day": today, "count": count + 1, "recent": (recent + [time.time()])[-20:]}
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(st))
        tmp.replace(path)


def s2_get(path, params, timeout, retries=5):
    """GET from Semantic Scholar: spaced and capped by s2_slot. The key never reaches output.

    Semantic Scholar refuses many requests (429) whatever the spacing (measured 2 November 2026: about
    half with the key), so refusals are retried after 2, 4, 8, 16, 16 s plus a random extra of up to half
    that, so sessions do not retry in step (Brooker, "Exponential Backoff and Jitter", AWS Architecture
    Blog, 2015). One summary line on stderr instead of a line per retry.
    """
    url = S2_API + path + "?" + urllib.parse.urlencode(params)
    headers = {"User-Agent": UA, "Accept": "application/json"}
    key = s2_key()
    if key:
        headers["x-api-key"] = key
    base = float(os.environ.get("S2_RETRY_BASE", "2"))  # shortened by the tests

    def clean(text):
        return text.replace(key, "[key]") if key else text

    started, refused = time.monotonic(), 0
    while True:
        s2_slot()
        req = urllib.request.Request(url, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                data = json.load(resp)
            if refused:
                print(f"websearch: Semantic Scholar refused {refused} time{'s' if refused > 1 else ''} (429) "
                      f"before answering; {time.monotonic() - started:.0f}s in all", file=sys.stderr)
            return data
        except urllib.error.HTTPError as e:
            if e.code != 429:
                body = e.read()[:200].decode("utf-8", "replace")
                sys.exit(clean(f"websearch: Semantic Scholar HTTP {e.code}: {body}"))
            refused += 1
            if refused > retries:
                break
            wait = base * 2 ** min(refused - 1, 3)
            time.sleep(wait + random.uniform(0, wait / 2))
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            sys.exit(clean(f"websearch: cannot reach Semantic Scholar: {e}"))
        except ValueError:  # e.g. a header value the HTTP library refuses; its message would quote the key
            sys.exit("websearch: the Semantic Scholar request could not be built (check the key file)")
    sys.exit(f"websearch: Semantic Scholar refused all {refused} tries (429) over {time.monotonic() - started:.0f}s"
             + ("" if key else f"; no key found at {config_dir() / 's2_api_key'}") + f"; {FALLBACK}")


def print_paper(i, r, snippets):
    ids = r.get("externalIds") or {}
    doi = ids.get("DOI")
    link = f"https://doi.org/{doi}" if doi else f"https://www.semanticscholar.org/paper/{r.get('paperId', '')}"
    authors = [a.get("name", "") for a in (r.get("authors") or [])]
    if len(authors) > 3:
        authors = authors[:3] + ["et al."]
    meta = [", ".join(authors), " ".join(x for x in (html.unescape(r.get("venue") or ""), str(r.get("year") or "")) if x),
            f"cited by {r.get('citationCount')}" if r.get("citationCount") is not None else ""]
    pmid = ids.get("PubMed")
    if pmid:
        meta.append(f"PMID {pmid}")
    oa = (r.get("openAccessPdf") or {}).get("url")
    print(f"{i:2}. {(r.get('title') or '').strip()}")
    print(f"    {link}")
    print(f"    [{' | '.join(m for m in meta if m)}]")
    if oa:
        print(f"    open access: {oa}")
    if snippets and r.get("abstract"):
        print(f"    {r['abstract'].strip()[:400]}")


def scholar(argv):
    ap = argparse.ArgumentParser(prog="websearch scholar", description="Academic search via the Semantic Scholar Academic Graph API (api.semanticscholar.org). Uses the key in ~/.config/research-tools/ when present; requests are spaced 1.1 s apart and capped at 200 a day.")
    ap.add_argument("query", nargs="*", help="search terms")
    ap.add_argument("--cited-by", metavar="ID", help="list papers citing ID (DOI:10.x/y, PMID:123, ARXIV:2101.00001, or an S2 paper id)")
    ap.add_argument("--references", metavar="ID", help="list papers that ID cites")
    ap.add_argument("-n", type=int, default=15, help="results (default 15, max 100)")
    ap.add_argument("-y", "--year", help="year or range, e.g. 2020, 2018-2024, 2020- (search only)")
    ap.add_argument("--type", help="comma list: Review,JournalArticle,MetaAnalysis,ClinicalTrial,... (search only)")
    ap.add_argument("--open-access", action="store_true", help="only papers with an open-access PDF (search only)")
    ap.add_argument("--min-citations", type=int, help="minimum citation count (search only)")
    ap.add_argument("-s", "--snippets", action="store_true", help="show the first 400 characters of each abstract")
    ap.add_argument("--json", action="store_true", help="raw JSON")
    ap.add_argument("--timeout", type=float, default=30)
    a = ap.parse_args(argv)
    n = max(1, min(a.n, 100))

    if a.cited_by or a.references:
        pid = a.cited_by or a.references
        kind = "citations" if a.cited_by else "references"
        sub = "citingPaper" if a.cited_by else "citedPaper"
        data = s2_get(f"/paper/{urllib.parse.quote(pid, safe=':')}/{kind}", {"fields": S2_FIELDS, "limit": n}, a.timeout)
        papers = [d[sub] for d in data.get("data", []) if d.get(sub)]
        label = f"papers citing {pid}" if a.cited_by else f"papers cited by {pid}"
        total = ""
    else:
        if not a.query:
            ap.error("give search terms, or --cited-by ID / --references ID")
        params = {"query": " ".join(a.query), "fields": S2_FIELDS, "limit": n}
        if a.year:
            params["year"] = a.year
        if a.type:
            params["publicationTypes"] = a.type
        if a.open_access:
            params["openAccessPdf"] = ""
        if a.min_citations is not None:
            params["minCitationCount"] = a.min_citations
        data = s2_get("/paper/search", params, a.timeout)
        papers = data.get("data", [])
        label = f"{params['query']!r}"
        total = f", {data.get('total')} total matches" if data.get("total") is not None else ""

    if a.json:
        json.dump(data, sys.stdout, indent=1, ensure_ascii=False)
        print()
        return
    print(f"# Semantic Scholar: {len(papers)} results for {label}{total}")
    for i, r in enumerate(papers, 1):
        print_paper(i, r, a.snippets)


# Comparing result lists (done check 6).
# Links are tidied first so trivial differences do not count: scheme, "www.", host case, default port,
# trailing slash, "#" part, percent-encoding, parameter order, and tracking parameters.
TRACKING = {"gclid", "dclid", "fbclid", "msclkid", "yclid", "mc_cid", "mc_eid", "igshid", "srsltid",
            "_ga", "_gl", "_hsenc", "_hsmi", "mkt_tok"}
RBO_P = 0.9  # Webber, Moffat and Zobel (2010) use 0.9 to compare search engines; the top 10 carry 86% of the weight


def norm_url(url):
    url = url.strip()
    if "://" not in url:
        url = "http://" + url
    try:
        p = urllib.parse.urlsplit(url)
        host = (p.hostname or "").lower()
    except ValueError:  # malformed, e.g. "http://[::1": compare it as written
        return url.lower()
    if host.startswith("www."):
        host = host[4:]
    try:
        port = p.port
    except ValueError:
        port = None
    if port and port not in (80, 443):
        host += f":{port}"
    path = urllib.parse.unquote(p.path).rstrip("/")
    query = [(k, v) for k, v in urllib.parse.parse_qsl(p.query, keep_blank_values=True)
             if not (k.lower().startswith("utm_") or k.lower() in TRACKING)]
    q = urllib.parse.urlencode(sorted(query))
    return host + path + ("?" + q if q else "")


def rbo_ext(a, b, p=RBO_P):
    """Extrapolated rank-biased overlap of two rankings without repeats (Webber, Moffat and Zobel,
    "A Similarity Measure for Indefinite Rankings", ACM TOIS 28(4), 2010, equation 32; equation 23 when
    the lengths are equal). 1 means the same order, 0 nothing shared."""
    S, L = (a, b) if len(a) <= len(b) else (b, a)
    s, l = len(S), len(L)
    if s == 0:
        return 0.0
    seen_s, seen_l, X = set(), set(), [0] * (l + 1)
    for d in range(1, l + 1):
        x = X[d - 1]
        item_l = L[d - 1]
        if d <= s:
            item_s = S[d - 1]
            if item_s == item_l:
                x += 1
            else:
                x += (item_s in seen_l) + (item_l in seen_s)
            seen_s.add(item_s)
        else:
            x += item_l in seen_s
        seen_l.add(item_l)
        X[d] = x
    total = sum(X[d] / d * p ** d for d in range(1, l + 1))
    total += sum(X[s] * (d - s) / (s * d) * p ** d for d in range(s + 1, l + 1))
    return (1 - p) / p * total + ((X[l] - X[s]) / l + X[s] / s) * p ** l


def compare_lists(a, b):
    """Compare two ranked lists of URLs. Returns the shared and unique links (as given in the
    first list where shared) and the numbers: counts, overlap share, top-10 shared, and RBO."""
    def tidy(urls):
        keys, firsts = [], {}
        for u in urls:
            k = norm_url(u)
            if k and k not in firsts:
                firsts[k] = u
                keys.append(k)
        return keys, firsts
    ka, fa = tidy(a)
    kb, fb = tidy(b)
    sa, sb = set(ka), set(kb)
    union = sa | sb
    return {
        "n_a": len(ka), "n_b": len(kb),  # after tidying and removing repeats
        "both": [fa[k] for k in ka if k in sb],
        "only_a": [fa[k] for k in ka if k not in sb],
        "only_b": [fb[k] for k in kb if k not in sa],
        "overlap": len(sa & sb) / len(union) if union else None,
        "top10_shared": len(set(ka[:10]) & set(kb[:10])),
        # agreement at depth k = len(first list): shared links among both top-k lists, divided by k (Webber et al. eq. 3)
        "overlap_at_depth": len(set(ka) & set(kb[:len(ka)])) / len(ka) if ka else None,
        "rbo": rbo_ext(ka, kb) if union else None,
        "rbo_p": RBO_P,
    }


def read_url_list(path):
    """URLs from a file (or - for stdin): one per line, SearXNG JSON, or a JSON list of strings or {url: ...}."""
    text = sys.stdin.read() if path == "-" else Path(path).read_text()
    try:
        data = json.loads(text)
    except ValueError:
        return [line.strip() for line in text.splitlines() if line.strip() and not line.startswith("#")]
    if isinstance(data, dict):
        data = data.get("results", [])
    return [d if isinstance(d, str) else d.get("url", "") for d in data if d]


def fmt(x):
    return "n/a" if x is None else f"{x:.2f}"


def compare(argv):
    ap = argparse.ArgumentParser(prog="websearch compare", description="Which links two result lists share, "
                                 "and which only one has. Lists: one URL per line, SearXNG JSON, or a JSON list.")
    ap.add_argument("first", help="file with the first list (- for stdin)")
    ap.add_argument("second", nargs="?", help="file with the second list")
    ap.add_argument("--query", help="instead of a second file, search SearXNG for this now")
    ap.add_argument("--labels", default=None, help="names for the two lists, e.g. built-in,searxng")
    ap.add_argument("--json", action="store_true", help="print the comparison as JSON")
    a = ap.parse_args(argv)
    if bool(a.second) == bool(a.query):
        ap.error("give a second file or --query, not both")
    labels = (a.labels or ("first,searxng" if a.query else "first,second")).split(",", 1)
    try:
        first = read_url_list(a.first)
        if a.query:
            data = searx_search(DEFAULT_URL, {"q": a.query, "format": "json", "categories": "general", "language": "en"})
            second = [r.get("url", "") for r in data.get("results", [])]
        else:
            second = read_url_list(a.second)
    except OSError as e:
        sys.exit(f"websearch: cannot read {e.filename}: {e.strerror}")
    except Unavailable as e:
        sys.exit(f"websearch: {e}")
    c = compare_lists(first, second)
    if a.json:
        json.dump(dict(c, labels=labels), sys.stdout, indent=1, ensure_ascii=False)
        print()
        return
    la, lb = labels
    print(f"# {la} ({c['n_a']} links) vs {lb} ({c['n_b']} links)")
    print(f"# in both: {len(c['both'])} | only {la}: {len(c['only_a'])} | only {lb}: {len(c['only_b'])} | "
          f"overlap {fmt(c['overlap'])} | top-10 shared {c['top10_shared']} | RBO {fmt(c['rbo'])} (p={RBO_P})")
    for title, urls in (("in both", c["both"]), (f"only in {la}", c["only_a"]), (f"only in {lb}", c["only_b"])):
        print(f"## {title}")
        for i, u in enumerate(urls, 1):
            print(f"{i:2}. {u}")


# The experiment (done check 7): bin/websearch-hook logs every built-in search next to a SearXNG search.
EXPERIMENT_DIR = Path(os.environ.get("RT_EXPERIMENT_DIR") or REPO / "experiment")
OUTBOX = Path("/mnt/code/_share/outbox/research-tools")


def experiment_on():
    """The switch lives in ~/.config/research-tools/experiment; no file means on (installing the hook opts in)."""
    try:
        word = (config_dir() / "experiment").read_text().strip().lower()
    except FileNotFoundError:
        return True
    return word not in ("off", "false", "0", "no", "disabled")


def median(xs):
    xs = sorted(xs)
    if not xs:
        return None
    m = len(xs) // 2
    return xs[m] if len(xs) % 2 else (xs[m - 1] + xs[m]) / 2


def experiment_report():
    """The report as text, built from the numbers each log line already holds."""
    path = EXPERIMENT_DIR / "log.jsonl"
    lines = []
    if path.exists():
        for raw in path.read_text().splitlines():
            try:
                lines.append(json.loads(raw))
            except ValueError:
                pass
    answered = [l for l in lines if l.get("searxng", {}).get("ok") and l.get("compare")]
    degraded = [l for l in answered if l["searxng"].get("degraded")]
    ok = [l for l in answered if not l["searxng"].get("degraded")]
    pairs = [(l["compare"].get("overlap_at_depth"), l["compare"]["n_both"]) for l in ok
             if l["compare"].get("overlap_at_depth") is not None]
    agree = [a for a, _ in pairs]
    buckets = {"identical": sum(a == 1 for a, _ in pairs), "mostly the same": sum(0.5 <= a < 1 for a, _ in pairs),
               "mostly different": sum(a < 0.5 and n > 0 for a, n in pairs),
               "nothing shared": sum(n == 0 for _, n in pairs)}
    n_both = sum(l["compare"]["n_both"] for l in ok)
    n_builtin = sum(l["compare"].get("n_builtin", len(l["builtin"]["results"])) for l in ok)
    n_searx = sum(l["compare"].get("n_searxng", len(l["searxng"]["results"])) for l in ok)
    fails = {}
    for l in lines:
        for e in l.get("searxng", {}).get("failed_engines") or []:
            fails[e[0]] = fails.get(e[0], 0) + 1
    span = f"{lines[0]['ts'][:10]} to {lines[-1]['ts'][:10]}, UTC" if lines else "none yet"
    pct = lambda a, b: f"{a} of {b} ({100 * a / b:.0f}%)" if b else f"{a} of {b}"
    out = [f"# SearXNG vs built-in search: experiment report ({time.strftime('%Y-%m-%d')})", "",
           f"searches logged: {len(lines)} ({span})",
           f"SearXNG unavailable: {len(lines) - len(answered)}",
           f"SearXNG returned nothing (engines blocked or failed): {len(degraded)}",
           "(both left out of the numbers below)", "",
           "How alike were the two lists? Agreement at depth k: the share of the built-in search's k links",
           "that are also in SearXNG's top k. \"Nothing shared\" means no link in common anywhere in the lists."]
    out += [f"  {k}: {v}" for k, v in buckets.items()]
    out += [f"  median agreement: {fmt(median(agree))}",
            f"  median RBO (p={RBO_P}): {fmt(median([l['compare']['rbo'] for l in ok if l['compare'].get('rbo') is not None]))}",
            "", f"built-in links SearXNG also found: {pct(n_both, n_builtin)}",
            f"SearXNG links the built-in search also found: {pct(n_both, n_searx)}", "",
            "engines that failed most often (searches affected):"]
    out += [f"  {name}: {n}" for name, n in sorted(fails.items(), key=lambda x: -x[1])[:10]] or ["  none"]
    return "\n".join(out) + "\n"


def experiment(argv):
    ap = argparse.ArgumentParser(prog="websearch experiment", description="The built-in vs SearXNG experiment.")
    ap.add_argument("action", choices=["on", "off", "status", "report"])
    ap.add_argument("--save", action="store_true", help="report: also save it to the outbox")
    a = ap.parse_args(argv)
    if a.action in ("on", "off"):
        config_dir().mkdir(parents=True, exist_ok=True)
        (config_dir() / "experiment").write_text(a.action + "\n")
        print(f"experiment {a.action}")
    elif a.action == "status":
        log = EXPERIMENT_DIR / "log.jsonl"
        n = len(log.read_text().splitlines()) if log.exists() else 0
        print(f"experiment {'on' if experiment_on() else 'off'}; {n} searches logged in {log}")
    else:
        text = experiment_report()
        print(text, end="")
        if a.save:
            OUTBOX.mkdir(parents=True, exist_ok=True)
            out = OUTBOX / f"{time.strftime('%Y-%m-%d')}-experiment-report.md"
            out.write_text(text)
            print(f"saved to {out}")


HUB_TAGS = "https://hub.docker.com/v2/repositories/searxng/searxng/tags?page_size=10&ordering=last_updated"


def docker(args, **kw):
    return subprocess.run(docker_cmd(args), capture_output=True, text=True, **kw)


def compose(args, **kw):
    return docker(["compose", "-f", str(COMPOSE_FILE), *args], **kw)


def pinned_image():
    for line in COMPOSE_FILE.read_text().splitlines():
        if line.strip().startswith("image:"):
            return line.split("image:", 1)[1].strip()
    return None


def server(argv):
    ap = argparse.ArgumentParser(prog="websearch server", description="Manage the local SearXNG container.")
    ap.add_argument("action", choices=["status", "start", "stop", "update"])
    a = ap.parse_args(argv)
    base = DEFAULT_URL

    if a.action == "status":
        r = docker(["inspect", "-f", "{{.State.Status}}", "searxng"])
        state = r.stdout.strip() if r.returncode == 0 else f"no container ({(r.stderr.strip() or 'docker failed')[:200]})"
        print(f"container: {state}")
        print(f"answering at {base}: {'yes' if healthy(base) else 'no'}")
        print(f"pinned image: {pinned_image()}")
    elif a.action == "start":
        problem = ensure_server(base, time.monotonic() + 120)
        if problem:
            sys.exit(f"websearch: {problem}")
        print(f"SearXNG is answering at {base}")
    elif a.action == "stop":
        r = compose(["stop"])
        if r.returncode != 0:
            sys.exit(f"websearch: stop failed: {r.stderr.strip()[-300:]}")
        print("SearXNG stopped. The next search starts it again.")
    elif a.action == "update":
        req = urllib.request.Request(HUB_TAGS, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=20) as resp:
            tags = json.load(resp)["results"]
        newest = next((t for t in tags if t["name"] != "latest" and t.get("digest")), None)
        if not newest:
            sys.exit("websearch: Docker Hub listed no usable SearXNG tag")
        old, new = pinned_image(), f"docker.io/searxng/searxng:{newest['name']}@{newest['digest']}"
        if old == new:
            print(f"Already on the newest image: {new}")
            return
        COMPOSE_FILE.write_text(COMPOSE_FILE.read_text().replace(old, new))
        for step in (["pull"], ["up", "-d"]):
            r = compose(step)
            if r.returncode != 0:
                COMPOSE_FILE.write_text(COMPOSE_FILE.read_text().replace(new, old))
                sys.exit(f"websearch: compose {step[0]} failed, pin restored: {r.stderr.strip()[-300:]}")
        print(f"image: {old}\n    -> {new}\nCommit searxng/docker-compose.yml to record the new pin.")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("query", nargs="+", help="search terms (SearXNG syntax, e.g. !pubmed or site:example.com)")
    ap.add_argument("-n", type=int, default=15, help="results to show (default 15)")
    ap.add_argument("-c", "--category", default="general", help="general, science, news, it, files, ... (default general)")
    ap.add_argument("-t", "--time-range", choices=["day", "month", "year"], help="restrict by recency")
    ap.add_argument("-p", "--page", type=int, default=1)
    ap.add_argument("-l", "--language", default="en")
    ap.add_argument("-s", "--snippets", action="store_true", help="show the content snippet under each result")
    ap.add_argument("--json", action="store_true", help="print the raw JSON response instead of a list")
    ap.add_argument("--url", default=DEFAULT_URL, help=f"SearXNG base URL (default {DEFAULT_URL})")
    ap.add_argument("--public", action="store_true", help=f"use the public instance {PUBLIC_URL}")
    ap.add_argument("--timeout", type=float, default=30)
    a = ap.parse_args()

    base = PUBLIC_URL if a.public else a.url
    params = {"q": " ".join(a.query), "format": "json", "categories": a.category,
              "pageno": a.page, "language": a.language}
    if a.time_range:
        params["time_range"] = a.time_range

    try:
        data = searx_search(base, params, a.timeout)
    except Unavailable as e:
        sys.exit(f"websearch: {e}")

    failed = failed_engines(data)
    if a.json:
        json.dump(data, sys.stdout, indent=1, ensure_ascii=False)
        print()
        if failed:
            print(f"# {failed}", file=sys.stderr)
        return

    results = data.get("results", [])
    print(f"# {len(results)} results from {base} for {params['q']!r} (page {a.page}, {a.category})")
    if failed:
        print(f"# {failed}")
    for i, r in enumerate(results[: a.n], 1):
        engines = ",".join(r.get("engines") or [])
        date = (r.get("publishedDate") or "")[:10]
        meta = " | ".join(x for x in (engines, date) if x)
        print(f"{i:2}. {r.get('title', '').strip()}")
        print(f"    {r.get('url', '')}")
        if meta:
            print(f"    [{meta}]")
        if a.snippets and r.get("content"):
            print(f"    {r['content'].strip()[:300]}")
    extra = [k for k in ("answers", "infoboxes", "suggestions") if data.get(k)]
    if extra:
        print(f"# also in JSON: {', '.join(extra)}")


def command(argv):
    """The subcommand argv names, or None for a plain search. A command word followed by something that does not
    fit the command ("compare postgres vs mysql", "server side rendering") is a search; `websearch -- ...` forces one."""
    if len(argv) < 3:
        return None
    word, nxt = argv[1], argv[2]
    helpish = nxt in ("-h", "--help")
    if word == "scholar":
        return scholar
    if word == "server" and (nxt in ("status", "start", "stop", "update") or helpish):
        return server
    if word == "experiment" and (nxt in ("on", "off", "status", "report") or helpish):
        return experiment
    looks_like_file = "/" in nxt or nxt.endswith((".txt", ".json", ".jsonl", ".md")) or Path(nxt).is_file()
    if word == "compare" and (nxt == "-" or helpish or looks_like_file):
        return compare
    return None


if __name__ == "__main__":
    cmd = command(sys.argv)
    if cmd:
        cmd(sys.argv[2:])
    else:
        main()
