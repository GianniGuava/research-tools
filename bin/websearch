#!/usr/bin/env python3
"""Query a SearXNG instance and print the raw ranked results.

Standard library only. Default instance is the NAS (SEARXNG_URL or http://10.0.0.16:8888).
--public falls back to a public instance that allows JSON output.
"""
import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

DEFAULT_URL = os.environ.get("SEARXNG_URL", "http://10.0.0.16:8888")
PUBLIC_URL = os.environ.get("SEARXNG_PUBLIC_URL", "https://searx.be")
UA = "Mozilla/5.0 (X11; Linux x86_64) research-tools/websearch"


def search(base, params, timeout):
    url = base.rstrip("/") + "/search?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        body = resp.read()
    try:
        return json.loads(body), url
    except json.JSONDecodeError:
        head = body[:120].decode("utf-8", "replace").strip().replace("\n", " ")
        raise SystemExit(f"websearch: {base} did not return JSON (got: {head!r}). "
                         "Public instances usually disable the JSON API or sit behind a browser check; use the NAS instance.")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("query", nargs="+", help="search terms (SearXNG syntax, e.g. !pubmed or site:example.com)")
    ap.add_argument("-n", type=int, default=15, help="results to show (default 15)")
    ap.add_argument("-c", "--category", default="general", help="general, science, news, it, files, ... (default general)")
    ap.add_argument("-t", "--time-range", choices=["day", "month", "year"], help="restrict by recency")
    ap.add_argument("-p", "--page", type=int, default=1)
    ap.add_argument("-l", "--language", default="en")
    ap.add_argument("-s", "--snippets", action="store_true", help="show the content snippet under each result")
    ap.add_argument("--json", action="store_true", help="print the raw JSON response instead of a list")
    ap.add_argument("--url", default=DEFAULT_URL, help=f"SearXNG base URL (default {DEFAULT_URL})")
    ap.add_argument("--public", action="store_true", help=f"use the public instance {PUBLIC_URL}")
    ap.add_argument("--timeout", type=float, default=30)
    a = ap.parse_args()

    base = PUBLIC_URL if a.public else a.url
    params = {"q": " ".join(a.query), "format": "json", "categories": a.category,
              "pageno": a.page, "language": a.language}
    if a.time_range:
        params["time_range"] = a.time_range

    try:
        data, url = search(base, params, a.timeout)
    except urllib.error.HTTPError as e:
        hint = " (json format not enabled on this instance?)" if e.code == 403 else ""
        sys.exit(f"websearch: HTTP {e.code} from {base}{hint}")
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        sys.exit(f"websearch: cannot reach {base}: {e}")

    if a.json:
        json.dump(data, sys.stdout, indent=1, ensure_ascii=False)
        print()
        return

    results = data.get("results", [])
    print(f"# {len(results)} results from {base} for {params['q']!r} (page {a.page}, {a.category})")
    if data.get("unresponsive_engines"):
        bad = ", ".join(f"{e[0]} ({e[1]})" for e in data["unresponsive_engines"])
        print(f"# unresponsive engines: {bad}")
    for i, r in enumerate(results[: a.n], 1):
        engines = ",".join(r.get("engines") or [])
        date = (r.get("publishedDate") or "")[:10]
        meta = " | ".join(x for x in (engines, date) if x)
        print(f"{i:2}. {r.get('title', '').strip()}")
        print(f"    {r.get('url', '')}")
        if meta:
            print(f"    [{meta}]")
        if a.snippets and r.get("content"):
            print(f"    {r['content'].strip()[:300]}")
    extra = [k for k in ("answers", "infoboxes", "suggestions") if data.get(k)]
    if extra:
        print(f"# also in JSON: {', '.join(extra)}")


if __name__ == "__main__":
    main()
