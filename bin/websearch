#!/usr/bin/env python3
"""Query a SearXNG instance and print the raw ranked results.

Standard library only. Default instance is the container on this machine (SEARXNG_URL or
http://127.0.0.1:8888); if it is not answering, the tool starts it (waiting at most 5 seconds).
--public falls back to a public instance that allows JSON output.

    websearch server status|start|stop|update   manage the local SearXNG container

    websearch scholar <query>          academic search via the Semantic Scholar API
    websearch scholar --cited-by ID    papers citing ID (DOI:..., PMID:..., ARXIV:..., or an S2 id)
    websearch scholar --references ID  papers ID cites
"""
import argparse
import fcntl
import grp
import html
import json
import os
import shlex
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

T0 = time.monotonic()
REPO = Path(__file__).resolve().parent.parent
COMPOSE_FILE = REPO / "searxng" / "docker-compose.yml"
DEFAULT_URL = os.environ.get("SEARXNG_URL", "http://127.0.0.1:8888")
FALLBACK = "use the built-in web search for now"
START_WAIT = 4.5  # seconds from launch; done check 3 allows 5 in total
PUBLIC_URL = os.environ.get("SEARXNG_PUBLIC_URL", "https://searx.be")
UA = "Mozilla/5.0 (X11; Linux x86_64) research-tools/websearch"


def search(base, params, timeout):
    url = base.rstrip("/") + "/search?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        body = resp.read()
    try:
        return json.loads(body), url
    except json.JSONDecodeError:
        head = body[:120].decode("utf-8", "replace").strip().replace("\n", " ")
        raise SystemExit(f"websearch: {base} did not return JSON (got: {head!r}). "
                         "Public instances usually disable the JSON API or sit behind a browser check; use the local instance.")


def failed_engines(data):
    """One line naming each engine that failed or blocked the server, with SearXNG's reason; '' when none did."""
    bad = [f"{e[0]} ({e[1]})" if len(e) > 1 and e[1] else str(e[0]) for e in data.get("unresponsive_engines") or []]
    return f"failed engines, results may be missing: {', '.join(bad)}" if bad else ""


def state_dir():
    d = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "research-tools"
    d.mkdir(parents=True, exist_ok=True)
    return d


def is_local(base):
    return urllib.parse.urlparse(base).hostname in ("127.0.0.1", "localhost", "::1")


def healthy(base, timeout=1.0):
    try:
        with urllib.request.urlopen(base.rstrip("/") + "/healthz", timeout=timeout) as resp:
            return resp.status == 200
    except (urllib.error.URLError, TimeoutError, OSError):
        return False


def docker_cmd(args):
    """A docker command line, run through `sg docker` when this process started before the account joined the group."""
    try:
        gid = grp.getgrnam("docker").gr_gid
    except KeyError:
        return ["docker", *args]
    if os.geteuid() == 0 or gid in os.getgroups():
        return ["docker", *args]
    return ["sg", "docker", "-c", shlex.join(["docker", *args])]


def start_command():
    override = os.environ.get("WEBSEARCH_START_CMD")  # used by the tests
    return shlex.split(override) if override else docker_cmd(["compose", "-f", str(COMPOSE_FILE), "up", "-d"])


def last_line(path):
    try:
        lines = [l.strip() for l in Path(path).read_text(errors="replace").splitlines() if l.strip()]
    except OSError:
        return "no output"
    return lines[-1][:200] if lines else "no output"


def ensure_server(base, deadline):
    """Start the local server if it is not answering. Returns None once it answers, else a one-line reason.

    A lock keeps two sessions from starting it at once. The start command keeps running after this
    returns, so a server that is still starting is ready for the next search.
    """
    lock_path = state_dir() / "searxng-start.lock"
    log_path = state_dir() / "searxng-start.log"
    starting = f"SearXNG is starting, not ready yet; {FALLBACK}"
    with open(lock_path, "a") as lock:
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    return starting
                time.sleep(0.1)
        if healthy(base):
            return None
        with open(log_path, "w") as log:
            try:
                proc = subprocess.Popen(start_command(), stdin=subprocess.DEVNULL, stdout=log,
                                        stderr=subprocess.STDOUT, start_new_session=True)
            except OSError as e:
                return f"SearXNG is down and could not be started ({e}); {FALLBACK}"
        while time.monotonic() < deadline:
            if healthy(base, timeout=0.5):
                return None
            rc = proc.poll()
            if rc is not None and rc != 0:
                return (f"SearXNG is down and could not be started ({last_line(log_path)}); {FALLBACK}. "
                        f"Details: {log_path} and `docker logs searxng`")
            time.sleep(0.2)
        return starting

S2_API = "https://api.semanticscholar.org/graph/v1"
S2_FIELDS = "title,authors,year,publicationDate,venue,externalIds,citationCount,openAccessPdf,publicationTypes,abstract"


def s2_get(path, params, timeout, tries=4):
    """GET from Semantic Scholar with backoff. The unauthenticated pool is shared and often returns 429."""
    url = S2_API + path + "?" + urllib.parse.urlencode(params)
    headers = {"User-Agent": UA, "Accept": "application/json"}
    key = os.environ.get("S2_API_KEY")
    if key:
        headers["x-api-key"] = key
    delay = 2
    for attempt in range(1, tries + 1):
        req = urllib.request.Request(url, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return json.load(resp)
        except urllib.error.HTTPError as e:
            if e.code == 429 and attempt == tries:
                break
            if e.code == 429 and attempt < tries:
                print(f"websearch: Semantic Scholar rate-limited (429), retry {attempt}/{tries - 1} in {delay}s"
                      + ("" if key else "; set S2_API_KEY for your own quota"), file=sys.stderr)
                time.sleep(delay)
                delay *= 2
                continue
            body = e.read()[:200].decode("utf-8", "replace")
            sys.exit(f"websearch: Semantic Scholar HTTP {e.code}: {body}")
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            sys.exit(f"websearch: cannot reach Semantic Scholar: {e}")
    sys.exit("websearch: Semantic Scholar still rate-limited after retries. "
             "Apply for a free key at https://www.semanticscholar.org/product/api#api-key-form and export S2_API_KEY.")


def print_paper(i, r, snippets):
    ids = r.get("externalIds") or {}
    doi = ids.get("DOI")
    link = f"https://doi.org/{doi}" if doi else f"https://www.semanticscholar.org/paper/{r.get('paperId', '')}"
    authors = [a.get("name", "") for a in (r.get("authors") or [])]
    if len(authors) > 3:
        authors = authors[:3] + ["et al."]
    meta = [", ".join(authors), " ".join(x for x in (html.unescape(r.get("venue") or ""), str(r.get("year") or "")) if x),
            f"cited by {r.get('citationCount')}" if r.get("citationCount") is not None else ""]
    pmid = ids.get("PubMed")
    if pmid:
        meta.append(f"PMID {pmid}")
    oa = (r.get("openAccessPdf") or {}).get("url")
    print(f"{i:2}. {(r.get('title') or '').strip()}")
    print(f"    {link}")
    print(f"    [{' | '.join(m for m in meta if m)}]")
    if oa:
        print(f"    open access: {oa}")
    if snippets and r.get("abstract"):
        print(f"    {r['abstract'].strip()[:400]}")


def scholar(argv):
    ap = argparse.ArgumentParser(prog="websearch scholar", description="Academic search via the Semantic Scholar Academic Graph API (api.semanticscholar.org). No key needed; S2_API_KEY raises the rate limit.")
    ap.add_argument("query", nargs="*", help="search terms")
    ap.add_argument("--cited-by", metavar="ID", help="list papers citing ID (DOI:10.x/y, PMID:123, ARXIV:2101.00001, or an S2 paper id)")
    ap.add_argument("--references", metavar="ID", help="list papers that ID cites")
    ap.add_argument("-n", type=int, default=15, help="results (default 15, max 100)")
    ap.add_argument("-y", "--year", help="year or range, e.g. 2020, 2018-2024, 2020- (search only)")
    ap.add_argument("--type", help="comma list: Review,JournalArticle,MetaAnalysis,ClinicalTrial,... (search only)")
    ap.add_argument("--open-access", action="store_true", help="only papers with an open-access PDF (search only)")
    ap.add_argument("--min-citations", type=int, help="minimum citation count (search only)")
    ap.add_argument("-s", "--snippets", action="store_true", help="show the first 400 characters of each abstract")
    ap.add_argument("--json", action="store_true", help="raw JSON")
    ap.add_argument("--timeout", type=float, default=30)
    a = ap.parse_args(argv)
    n = max(1, min(a.n, 100))

    if a.cited_by or a.references:
        pid = a.cited_by or a.references
        kind = "citations" if a.cited_by else "references"
        sub = "citingPaper" if a.cited_by else "citedPaper"
        data = s2_get(f"/paper/{urllib.parse.quote(pid, safe=':')}/{kind}", {"fields": S2_FIELDS, "limit": n}, a.timeout)
        papers = [d[sub] for d in data.get("data", []) if d.get(sub)]
        label = f"papers citing {pid}" if a.cited_by else f"papers cited by {pid}"
        total = ""
    else:
        if not a.query:
            ap.error("give search terms, or --cited-by ID / --references ID")
        params = {"query": " ".join(a.query), "fields": S2_FIELDS, "limit": n}
        if a.year:
            params["year"] = a.year
        if a.type:
            params["publicationTypes"] = a.type
        if a.open_access:
            params["openAccessPdf"] = ""
        if a.min_citations is not None:
            params["minCitationCount"] = a.min_citations
        data = s2_get("/paper/search", params, a.timeout)
        papers = data.get("data", [])
        label = f"{params['query']!r}"
        total = f", {data.get('total')} total matches" if data.get("total") is not None else ""

    if a.json:
        json.dump(data, sys.stdout, indent=1, ensure_ascii=False)
        print()
        return
    print(f"# Semantic Scholar: {len(papers)} results for {label}{total}")
    for i, r in enumerate(papers, 1):
        print_paper(i, r, a.snippets)


HUB_TAGS = "https://hub.docker.com/v2/repositories/searxng/searxng/tags?page_size=10&ordering=last_updated"


def docker(args, **kw):
    return subprocess.run(docker_cmd(args), capture_output=True, text=True, **kw)


def compose(args, **kw):
    return docker(["compose", "-f", str(COMPOSE_FILE), *args], **kw)


def pinned_image():
    for line in COMPOSE_FILE.read_text().splitlines():
        if line.strip().startswith("image:"):
            return line.split("image:", 1)[1].strip()
    return None


def server(argv):
    ap = argparse.ArgumentParser(prog="websearch server", description="Manage the local SearXNG container.")
    ap.add_argument("action", choices=["status", "start", "stop", "update"])
    a = ap.parse_args(argv)
    base = DEFAULT_URL

    if a.action == "status":
        r = docker(["inspect", "-f", "{{.State.Status}}", "searxng"])
        state = r.stdout.strip() if r.returncode == 0 else f"no container ({(r.stderr.strip() or 'docker failed')[:200]})"
        print(f"container: {state}")
        print(f"answering at {base}: {'yes' if healthy(base) else 'no'}")
        print(f"pinned image: {pinned_image()}")
    elif a.action == "start":
        problem = ensure_server(base, time.monotonic() + 120)
        if problem:
            sys.exit(f"websearch: {problem}")
        print(f"SearXNG is answering at {base}")
    elif a.action == "stop":
        r = compose(["stop"])
        if r.returncode != 0:
            sys.exit(f"websearch: stop failed: {r.stderr.strip()[-300:]}")
        print("SearXNG stopped. The next search starts it again.")
    elif a.action == "update":
        req = urllib.request.Request(HUB_TAGS, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=20) as resp:
            tags = json.load(resp)["results"]
        newest = next((t for t in tags if t["name"] != "latest" and t.get("digest")), None)
        if not newest:
            sys.exit("websearch: Docker Hub listed no usable SearXNG tag")
        old, new = pinned_image(), f"docker.io/searxng/searxng:{newest['name']}@{newest['digest']}"
        if old == new:
            print(f"Already on the newest image: {new}")
            return
        COMPOSE_FILE.write_text(COMPOSE_FILE.read_text().replace(old, new))
        for step in (["pull"], ["up", "-d"]):
            r = compose(step)
            if r.returncode != 0:
                COMPOSE_FILE.write_text(COMPOSE_FILE.read_text().replace(new, old))
                sys.exit(f"websearch: compose {step[0]} failed, pin restored: {r.stderr.strip()[-300:]}")
        print(f"image: {old}\n    -> {new}\nCommit searxng/docker-compose.yml to record the new pin.")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("query", nargs="+", help="search terms (SearXNG syntax, e.g. !pubmed or site:example.com)")
    ap.add_argument("-n", type=int, default=15, help="results to show (default 15)")
    ap.add_argument("-c", "--category", default="general", help="general, science, news, it, files, ... (default general)")
    ap.add_argument("-t", "--time-range", choices=["day", "month", "year"], help="restrict by recency")
    ap.add_argument("-p", "--page", type=int, default=1)
    ap.add_argument("-l", "--language", default="en")
    ap.add_argument("-s", "--snippets", action="store_true", help="show the content snippet under each result")
    ap.add_argument("--json", action="store_true", help="print the raw JSON response instead of a list")
    ap.add_argument("--url", default=DEFAULT_URL, help=f"SearXNG base URL (default {DEFAULT_URL})")
    ap.add_argument("--public", action="store_true", help=f"use the public instance {PUBLIC_URL}")
    ap.add_argument("--timeout", type=float, default=30)
    a = ap.parse_args()

    base = PUBLIC_URL if a.public else a.url
    params = {"q": " ".join(a.query), "format": "json", "categories": a.category,
              "pageno": a.page, "language": a.language}
    if a.time_range:
        params["time_range"] = a.time_range

    if not a.public and is_local(base) and not healthy(base):
        problem = ensure_server(base, T0 + START_WAIT)
        if problem:
            sys.exit(f"websearch: {problem}")
    try:
        data, url = search(base, params, a.timeout)
    except urllib.error.HTTPError as e:
        hint = " (json format not enabled on this instance?)" if e.code == 403 else ""
        sys.exit(f"websearch: HTTP {e.code} from {base}{hint}; {FALLBACK}")
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        sys.exit(f"websearch: cannot reach {base}: {e}; {FALLBACK}")

    failed = failed_engines(data)
    if a.json:
        json.dump(data, sys.stdout, indent=1, ensure_ascii=False)
        print()
        if failed:
            print(f"# {failed}", file=sys.stderr)
        return

    results = data.get("results", [])
    print(f"# {len(results)} results from {base} for {params['q']!r} (page {a.page}, {a.category})")
    if failed:
        print(f"# {failed}")
    for i, r in enumerate(results[: a.n], 1):
        engines = ",".join(r.get("engines") or [])
        date = (r.get("publishedDate") or "")[:10]
        meta = " | ".join(x for x in (engines, date) if x)
        print(f"{i:2}. {r.get('title', '').strip()}")
        print(f"    {r.get('url', '')}")
        if meta:
            print(f"    [{meta}]")
        if a.snippets and r.get("content"):
            print(f"    {r['content'].strip()[:300]}")
    extra = [k for k in ("answers", "infoboxes", "suggestions") if data.get(k)]
    if extra:
        print(f"# also in JSON: {', '.join(extra)}")


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "scholar":
        scholar(sys.argv[2:])
    elif len(sys.argv) > 1 and sys.argv[1] == "server":
        server(sys.argv[2:])
    else:
        main()
